#
# examples/embedded-team-app — THIS EXAMPLE'S OWN CONFIGURATION
#
# ─────────────────────────────────────────────────────────────────────────────
# These variables are NOT XRAY Workspace deployment configuration.
#
# They belong to this example process only. Nothing in the workspace reads
# them, and this example never reads `.env.local` or any workspace secret. Every value below is a placeholder — the keys are
# issued to you by the workspace when you register a service.
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` next to this file and load it however you prefer, e.g.
#
#   node --env-file=examples/embedded-team-app/.env examples/embedded-team-app/server.mjs
#
# The process validates all of this with Zod at startup (`config.mjs`) and
# refuses to run if anything is missing or malformed. It never prints a value.

# Port this example listens on.
TEAMAPP_PORT=4802

# Your registered service slug: 3–32 lowercase letters and digits, no hyphen.
# Must match the `service` field in the manifest and the `aud` claim on every
# identity token the workspace mints for you.
TEAMAPP_SERVICE_SLUG=teamapp

# The per-service HS256 key the workspace signs identity tokens with. You get
# it when your service is registered. It is a VERIFICATION key for you — you
# never mint with it. Minimum 24 characters.
TEAMAPP_EMBED_KEY=replace-me-with-the-embed-key-from-the-workspace

# OPTIONAL. A second key to keep accepting during a rotation window, so tokens
# already in flight and signed with the key being retired still verify.
#
# Note carefully: the workspace mints with exactly ONE key. There is no
# `embedKeyNext` field on the platform's credential record, and this variable
# does not imply one — it is purely your side of a rotation you have arranged.
# Leave it unset unless you are mid-rotation, and remove it afterwards.
# TEAMAPP_EMBED_KEY_PREVIOUS=

# The workspace origin, exactly: scheme, host, optional port, and nothing else.
# No trailing slash, no path. This one value does three jobs — it is the
# `frame-ancestors` in this app's CSP, the only origin the page accepts a
# postMessage token from, and the only host the authorization callback will
# talk to. HTTPS is required.
TEAMAPP_WORKSPACE_ORIGIN=https://workspace.xray.tech

# Your registered service API key. BACKEND ONLY. It authenticates this service
# to the workspace on the authorization callback. It is never sent to a
# browser, never embedded in the page, and is not a user identity: a request
# carrying only this key proves a caller, not a person. Minimum 24 characters,
# and it must differ from TEAMAPP_EMBED_KEY.
TEAMAPP_WORKSPACE_API_KEY=replace-me-with-the-service-api-key-from-the-workspace

# How long to wait for the authorization callback before failing CLOSED.
# Short on purpose: a slow answer is a denied request, not a held one.
TEAMAPP_AUTHORIZE_TIMEOUT_MS=2000

# Local development only. Permits an `http://127.0.0.1:PORT` workspace origin
# so you can run this against a workspace on your own machine. Never set this
# anywhere a real person's data could reach.
# TEAMAPP_ALLOW_INSECURE_LOOPBACK=false
